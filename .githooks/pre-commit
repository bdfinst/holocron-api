#!/bin/sh

# validates the previous step succeeded
function validate {
	if [ $? -eq 0 ]; then
		printf "\033[0;30m\033[42mSUCCEEDED\033[0m\n"
	else
		printf "\033[0;30m\033[41mFAILED\033[0m\n"
		exit 1
	fi
}

function run_linters {
	echo Running pylint...
	poetry run pylint app
	validate
    echo Running black...
    poetry run black . --check
    validate
    echo Running isort...
    poetry run isort . --check
    validate
    echo Running mypy...
    poetry run mypy .
    validate
    echo Running pydocstyle...
    poetry run pydocstyle .
    validate
}

run_linters
