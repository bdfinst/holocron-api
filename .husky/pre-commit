#!/bin/sh

# validates the previous step succeeded
function validate {
	if [ $? -eq 0 ]; then
		printf "\033[0;30m\033[42mSUCCEEDED\033[0m\n"
	else
		printf "\033[0;30m\033[41mFAILED\033[0m\n"
		exit 1
	fi
}

function run_linters {
  echo Running black...
  black . --check
  validate
  echo Running isort...
  isort . --check
  validate
  echo Running pydocstyle...
  pydocstyle .
  validate
  echo Running mypy...
  mypy .
  validate
  echo Running pylint...
  pylint --reports=y --recursive=y --persistent=n --verbose .
  validate
}

function run_tests {
  poetry shell
	echo Running tests...
	pytest --cov .
	validate
}

run_linters
run_tests
