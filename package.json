{
  "name": "holocron-api",
  "version": "1.0.0",
  "description": "Python backend for remixed edition of Holocron application. Replaces the Hygieia-API and the Holocron-Team-Service services. Uses Flask.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:e2e-ci": "cypress run --browser chrome --config-file cypress/config/config.config.js",
    "prepare": "husky install",
    "cypress:open": "cypress open --browser chrome --config-file cypress/config/config.config.js --config baseUrl=http://localhost",
    "cypress:run": "cypress run --browser chrome --config-file cypress/config/config.config.js --config baseUrl=http://localhost"
  },
  "devDependencies": {
    "cypress": "^13.13.1",
    "husky": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://repo1.dso.mil/platform-one/big-bang/apps/sandbox/holocron/holocron-api.git"
  },
  "author": "",
  "license": "ISC"
}
